# Server porti
PORT=3000
# Birinchi ishga tushirishda PM logini va paroli (parol bo'lmasa tasodifiy parol konsolga chiqadi)
ADMIN_LOGIN=pm
ADMIN_PASSWORD=
# Telegram bot tokeni — @BotFather
TELEGRAM_BOT_TOKEN=
# AI tahlil (Kechagi hisobot → 3-qadam). Kalit bo'lmasa — tahlil faqat tizim qoidalari bo'yicha.
# Provayder: deepseek (standart) | anthropic (Claude) | openai (OpenAI yoki OpenAI formatidagi boshqa xizmat)
AI_PROVIDER=deepseek
# Provayder kaliti: DeepSeek — https://platform.deepseek.com/api_keys
AI_API_KEY=
# Model (ixtiyoriy). deepseek: deepseek-v4-pro (standart) yoki deepseek-flash (tezroq, arzonroq);
# anthropic: claude-opus-5-5 (standart); openai: majburiy
AI_MODEL=
# Faqat AI_PROVIDER=openai da boshqa xizmat uchun manzil (ixtiyoriy), masalan https://api.openai.com/v1
AI_BASE_URL=
# Fikrlash darajasi (ixtiyoriy): deepseek — low | high | max; anthropic — low | medium | high | xhigh | max (standart high)
AI_EFFORT=
# Dollar kursi (keyin Sozlamalarda o'zgartirsa bo'ladi)
USD_RATE=12800
# Ma'lumotlar bazasi fayli
DB_PATH=./data/analytika.db
# HTTPS orqali ishlaganda 1 qiling
COOKIE_SECURE=0

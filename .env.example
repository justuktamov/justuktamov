# Server porti
PORT=3000
# Birinchi ishga tushirishda PM logini va paroli (parol bo'lmasa tasodifiy parol konsolga chiqadi)
ADMIN_LOGIN=pm
ADMIN_PASSWORD=
# Telegram bot tokeni — @BotFather
TELEGRAM_BOT_TOKEN=
# AI tahlil (Kechagi hisobot → 3-qadam). Kalit bo'lmasa — tahlil faqat tizim qoidalari bo'yicha.
# Provayder: openrouter (standart) | deepseek (DeepSeek ning o'z API si) | anthropic (Claude) | openai (OpenAI formatidagi boshqa xizmat)
AI_PROVIDER=openrouter
# Provayder kaliti: OpenRouter — https://openrouter.ai/keys
AI_API_KEY=
# Model (ixtiyoriy). openrouter: deepseek/deepseek-v4-pro (standart) yoki deepseek/deepseek-v4-flash (tezroq, arzonroq);
# deepseek: deepseek-v4-pro; anthropic: claude-opus-5-5; openai: majburiy
AI_MODEL=
# Faqat AI_PROVIDER=openai da boshqa xizmat uchun manzil (ixtiyoriy), masalan https://api.openai.com/v1
AI_BASE_URL=
# Fikrlash darajasi (ixtiyoriy): openrouter / deepseek — low | high | max; anthropic — low | medium | high | xhigh | max (standart high)
AI_EFFORT=
# Ilova manzili (ixtiyoriy), masalan https://crm.example.uz — OpenRouter statistikasida ilova sifatida ko'rinadi
APP_URL=
# Dollar kursi (keyin Sozlamalarda o'zgartirsa bo'ladi)
USD_RATE=12800
# Ma'lumotlar bazasi fayli
DB_PATH=./data/analytika.db
# HTTPS orqali ishlaganda 1 qiling
COOKIE_SECURE=0

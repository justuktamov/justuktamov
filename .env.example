# Server porti
PORT=3000
# Birinchi ishga tushirishda admin paroli (bo'lmasa tasodifiy parol konsolga chiqadi)
ADMIN_PASSWORD=
# AI tahlil uchun Anthropic (Claude) API kaliti — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Telegram bot tokeni — @BotFather
TELEGRAM_BOT_TOKEN=
# Dollar kursi (keyin Sozlamalarda o'zgartirsa bo'ladi)
USD_RATE=12800
# Ma'lumotlar bazasi fayli
DB_PATH=./data/analytika.db
# HTTPS orqali ishlaganda 1 qiling
COOKIE_SECURE=0
